# Copia este archivo a .env (que git ignora) y completa los valores.
# Se valida al arrancar (prometheus_platform.ops.settings): live exige claves y mainnet;
# paper exige testnet.
PQ_ENVIRONMENT=dev          # dev | paper | live
PQ_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR | CRITICAL
PQ_DATA_DIR=data            # raíz del lakehouse local (bronze/silver/gold)
# Claves de Binance: SIN permiso de retiro y con lista blanca de IP.
PQ_BINANCE_API_KEY=
PQ_BINANCE_API_SECRET=
PQ_BINANCE_TESTNET=true
PQ_TELEGRAM_BOT_TOKEN=
PQ_TELEGRAM_CHAT_ID=
