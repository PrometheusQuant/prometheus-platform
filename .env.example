# Copia este archivo a .env (que git ignora) y completa los valores.
# Se valida al arrancar (prometheus_platform.ops.settings): live exige claves y mainnet;
# paper exige testnet.
PQ_ENVIRONMENT=dev          # dev | paper | live
PQ_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR | CRITICAL
PQ_DATA_DIR=data            # raíz del lakehouse local (bronze/silver/gold)
# Claves de Binance: SIN permiso de retiro y con lista blanca de IP.
PQ_BINANCE_API_KEY=
PQ_BINANCE_API_SECRET=
PQ_BINANCE_TESTNET=true
# Alertas ERROR/CRITICAL (docs/runbooks/alertas.md). Probar con: uv run pq alert test
PQ_TELEGRAM_BOT_TOKEN=
PQ_TELEGRAM_CHAT_ID=
PQ_ALERT_TIMEZONE=America/La_Paz   # hora local en las alertas (logs y datos siguen en UTC)
# Límites de riesgo (docs/runbooks/kill-switch.md). Inválidos = el proceso no arranca.
PQ_RISK_MAX_NOTIONAL_SYMBOL_USD=500
PQ_RISK_MAX_NOTIONAL_TOTAL_USD=1000
PQ_RISK_MAX_LEVERAGE=1.0
PQ_RISK_HARD_LEVERAGE=1.5
PQ_RISK_MAX_DAILY_LOSS=0.02
PQ_RISK_MAX_HEDGE_IMBALANCE=0.15
PQ_RISK_IMBALANCE_GRACE_SECONDS=300

# Registro de ensayos compartido (PQ-112): david o boris. Cada carril escribe en
# docs/estrategias/ensayos/<carril>.jsonl; N es la suma de todos.
PQ_RESEARCH_LANE=david
# PQ_RESEARCH_AUTHOR=   # opcional; por defecto, git config user.name
