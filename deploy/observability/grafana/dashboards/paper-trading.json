    {
      "id": 14,
      "type": "logs",
      "title": "Logs de advertencia y error (Loki)",
      "description": "Líneas JSON de los procesos con level warning, error o critical. Sin secretos: redact_text.",
      "datasource": {
        "type": "loki",
        "uid": "pq-loki"
      },
      "gridPos": {
        "x": 6,
        "y": 28,
        "w": 18,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "pq-loki"
          },
          "expr": "{job=\"prometheusquant\", level=~\"warning|error|critical\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
